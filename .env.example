# Copy to .env and fill in as needed. Never commit the real .env file.

# Backend API base URL (see src/features/home/components/HomeSearchBar.js etc.)
REACT_APP_API_URL=http://localhost:5001/api

# Bangladesh PMTiles basemap archive. In development, serve it locally with:
#   npx serve map-build/data --cors -l 8080
# and leave this unset - src/features/map/mapBasemapStyle.js falls back to
# http://localhost:8080/bangladesh.pmtiles automatically. In production, set
# this to the hosted (S3/CDN) location once that deployment step is done.
REACT_APP_PMTILES_URL=http://localhost:8080/bangladesh.pmtiles
