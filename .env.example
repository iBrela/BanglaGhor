# Copy to .env and fill in as needed. Never commit the real .env file.

# Backend API base URL (see src/features/home/components/HomeSearchBar.js etc.)
REACT_APP_API_URL=http://localhost:5001/api

# Bangladesh PMTiles basemap archive. In development, serve it locally with:
#   npx serve map-build/data --cors -l 8082
# Port 8082 is the fixed local dev port for this project - ports 8080 and
# 8081 are commonly already bound by other local services on a dev machine
# (e.g. Docker containers from unrelated projects), which silently breaks
# the basemap if the server can't actually bind there. Keep this variable
# set (src/features/map/mapBasemapStyle.js's own fallback is still 8080) so
# the frontend and the local server always agree on the port.
# In production, set this to the hosted (S3/CDN) location once that
# deployment step is done.
REACT_APP_PMTILES_URL=http://localhost:8082/bangladesh.pmtiles